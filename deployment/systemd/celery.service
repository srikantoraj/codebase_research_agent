[Unit]
Description=Celery worker placeholder for future async research sessions
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/codebase-research-agent
EnvironmentFile=/var/www/codebase-research-agent/.env
ExecStart=/var/www/codebase-research-agent/venv/bin/celery -A config worker -l info
Restart=always

[Install]
WantedBy=multi-user.target
