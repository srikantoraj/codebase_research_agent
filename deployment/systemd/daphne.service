[Unit]
Description=Daphne ASGI Service
After=network.target redis-server.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/codebase_research_agent
EnvironmentFile=/home/ubuntu/codebase_research_agent/.env

ExecStart=/home/ubuntu/codebase_research_agent/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8001 \
    config.asgi:application

Restart=always

[Install]
WantedBy=multi-user.target