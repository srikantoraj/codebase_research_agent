[Unit]
Description=Daphne ASGI for Codebase Research Agent WebSockets
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/codebase-research-agent
EnvironmentFile=/var/www/codebase-research-agent/.env
ExecStart=/var/www/codebase-research-agent/venv/bin/daphne -b 127.0.0.1 -p 8001 config.asgi:application
Restart=always

[Install]
WantedBy=multi-user.target
