[Unit]
Description=Gunicorn for Codebase Research Agent
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/codebase-research-agent
EnvironmentFile=/var/www/codebase-research-agent/.env
ExecStart=/var/www/codebase-research-agent/venv/bin/gunicorn config.wsgi:application -c deployment/gunicorn/gunicorn.conf.py
Restart=always

[Install]
WantedBy=multi-user.target
