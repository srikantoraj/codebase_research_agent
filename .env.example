# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip

# Database
# Use sqlite for local/demo, postgres for production
DB_ENGINE=sqlite
DB_NAME=codebase_research_agent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Channels
REDIS_URL=redis://127.0.0.1:6379/0

# Repository storage
REPO_STORAGE_DIR=storage/repos

# LLM provider
# Options: openai, anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# LangSmith tracing - optional
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=codebase-research-agent

# Agent limits
AGENT_MAX_STEPS=8
AGENT_MAX_FILES_TO_READ=8
AGENT_MAX_FILE_CHARS=16000